# =============================================================
# MyPodcast - Variables de entorno requeridas
# Copia este archivo como .env.local y rellena los valores reales
# NUNCA subas .env.local a git (ya está en .gitignore)
# =============================================================

# Base de datos MongoDB
MONGODB_URI=mongodb://localhost:27017/mypodcast

# Secretos JWT - usa cadenas largas y aleatorias en producción
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_LARGA
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRA_CLAVE_ALEATORIA_DIFERENTE

# Puerto del servidor API
PORT=3000

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:4200
