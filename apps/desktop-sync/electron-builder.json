{
  "appId": "com.aremox.mypodcast.sync",
  "productName": "MyPodcastSync",
  "directories": {
    "output": "../../release/desktop-sync"
  },
  "files": [
    "**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MyPodcast Sync Agent",
    "runAfterFinish": true
  }
}
