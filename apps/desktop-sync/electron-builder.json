{
  "appId": "com.aremox.mypodcast.sync",
  "productName": "MyPodcastSync",
  "directories": {
    "output": "../../release/desktop-sync"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "aremox",
      "repo": "MyPodcast"
    }
  ],
  "files": [
    "**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "MyPodcast Sync Agent",
    "runAfterFinish": true,
    "include": "installer.nsh"
  }
}
